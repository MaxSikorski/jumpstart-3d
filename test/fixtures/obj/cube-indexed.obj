# The same 20 mm cube, using relative indices and all slash forms.
mtllib ignored-materials.mtl
o IndexedCube
v 0 0 0
v 20 0 0
v 20 20 0
v 0 20 0
v 0 0 20
v 20 0 20
v 20 20 20
v 0 20 20
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 1 0 0
vn 0 1 0
vn -1 0 0
g Caps
usemtl IgnoredMaterial
s off
f -8/1/1 -5/2/1 -6/3/1 -7/4/1
f -4/-4/-5 -3/-3/-5 -2/-2/-5 -1/-1/-5
g Sides
f -8//3 -7//3 -3//3 -4//3
f -7//4 -6//4 -2//4 -3//4
f -6/1 -5/2 -1/3 -2/4
f -5/1 -8/2 -4/3 -1/4 # close the last side
