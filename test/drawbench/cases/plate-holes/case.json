    "dims": [
      { "view": "top", "type": "linear", "along": "x", "from": [0, 0], "to": [80, 0], "at": -12, "text": "80" },
      { "view": "top", "type": "linear", "along": "y", "from": [0, 0], "to": [0, 50], "at": -12, "text": "50" },
      { "view": "top", "type": "linear", "along": "x", "from": [0, 42], "to": [8, 42], "at": 60, "text": "8" },
      { "view": "top", "type": "linear", "along": "x", "from": [0, 20], "to": [30, 20], "at": 70, "text": "30" },
      { "view": "top", "type": "linear", "along": "x", "from": [0, 42], "to": [72, 42], "at": 80, "text": "72" },
      { "view": "top", "type": "linear", "along": "y", "from": [80, 0], "to": [72, 8], "at": 92, "text": "8" },
      { "view": "top", "type": "linear", "along": "y", "from": [80, 0], "to": [30, 20], "at": 102, "text": "20" },
      { "view": "top", "type": "linear", "along": "y", "from": [80, 0], "to": [72, 42], "at": 112, "text": "42" },
      { "view": "top", "type": "leader", "point": [72, 8], "r": 2.75, "to": [96, -16], "text": "4X Ø5.5 THRU" },
      { "view": "top", "type": "leader", "point": [30, 20], "r": 5, "to": [-22, -16], "text": "Ø10 THRU" },
      { "view": "top", "type": "centre", "point": [30, 20], "r": 5 },
      { "view": "front", "type": "linear", "along": "y", "from": [80, 0], "to": [80, 6], "at": 92, "text": "6" }
