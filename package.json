{
  "name": "jumpstart-3d",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "playwright test",
    "test:site": "playwright test --project=site",
    "test:single": "playwright test --project=single",
    "test:mobile": "playwright test --project=mobile",
    "test:update": "UPDATE_GOLDEN=1 playwright test --project=site",
    "test:mcp": "cd mcp && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "ws": "8.22.0"
  }
}
